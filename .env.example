# 집 미니 PC 분산 워커 환경변수
# 셋업: cp .env.example .env → 값 채우기 → docker compose up -d

# ─────────────────────────────────────────────────────────────────────────
# 공통
# ─────────────────────────────────────────────────────────────────────────
WORKER_NAME=home_seoul

# ─────────────────────────────────────────────────────────────────────────
# 1) Collector — 회사 mk_postgres + mk_redis 접속용
# ─────────────────────────────────────────────────────────────────────────
# Tailscale 셋업 후 회사 PC 의 IP 입력. `tailscale ip -4` 로 확인.
DATABASE_URL=postgresql://admin:admin1234@100.64.0.5:5433/marketing_intelligence
REDIS_URL=redis://100.64.0.5:6379

# ─────────────────────────────────────────────────────────────────────────
# 2) PostgreSQL Replica — 회사 master 에서 streaming 받아옴
# ─────────────────────────────────────────────────────────────────────────
MASTER_HOST=100.64.0.5      # 회사 PC Tailscale IP (DATABASE_URL 과 동일 IP)
MASTER_PORT=5433             # 회사 mk_postgres 호스트 포트
POSTGRES_PASSWORD=admin1234  # admin 사용자 비번 (회사 master 와 동일)
REPLICATOR_USER=replicator
REPLICATOR_PASSWORD=replace_with_strong_password_xxxxxxxx  # 회사 master 에서 만든 replicator 비번

# ─────────────────────────────────────────────────────────────────────────
# 3) 검색광고 API (옵션) — 별도 광고주 키로 한도 분산. 비워두면 회사 측만 사용
# ─────────────────────────────────────────────────────────────────────────
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ─────────────────────────────────────────────────────────────────────────
# 4) 보안 더미 (collector 모드에선 안 쓰지만 32자+ 필수)
# ─────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace_with_32_plus_random_chars_xxxxxxx
ENCRYPTION_KEY=replace_with_32_plus_random_chars_xxxxxxx
