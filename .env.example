# 집 미니 PC 분산 워커 환경변수
# 셋업: cp .env.example .env → 값 채우기 → docker compose up -d

# 워커 이름 (로그 식별용)
WORKER_NAME=home_seoul

# ── Tailscale 내부 IP — 회사 PC 의 Tailscale IP 입력 ──
# Tailscale 셋업 후 회사 PC 에서 `tailscale ip -4` 로 확인.
# 예: 100.64.0.5 (Tailscale 의 100.x.x.x 대역).
# mk_postgres 는 호스트 5433 → 컨테이너 5432, mk_redis 는 호스트 6379 → 6379.
# 회사 docker-compose 의 ports 매핑 확인 후 호스트 포트 사용.
DATABASE_URL=postgresql://admin:admin1234@100.64.0.5:5433/marketing_intelligence
REDIS_URL=redis://100.64.0.5:6379

# ── 검색광고 API (옵션) ──
# collector 가 cleanup cron 의 검색량 측정도 분담하려면 별도 광고주 키 추가.
# 비워두면 회사 측 cleanup 만 동작 (안전, 단 측정 속도 1배).
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── 보안 더미 (collector 모드에선 안 쓰지만 32자+ 필수) ──
NEXTAUTH_SECRET=replace_with_32_plus_random_chars_xxxxxxx
ENCRYPTION_KEY=replace_with_32_plus_random_chars_xxxxxxx
